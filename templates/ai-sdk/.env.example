# A workspace agent key from One Brain (Agents, or `onebrain admin keys create <agent>`).
ONEBRAIN_API_KEY=
# Your One Brain API. The hosted one is https://api.useonebrain.com.
ONEBRAIN_URL=https://api.useonebrain.com
# Outside Vercel: an AI Gateway key (https://vercel.com/ai-gateway). On Vercel it is not needed.
AI_GATEWAY_API_KEY=
# Optional: any AI Gateway model id. Default anthropic/claude-sonnet-5.5.
MODEL=
