{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onebrain-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  // The Agents SDK uses AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI, for the default model: free up to the daily allocation.
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Assistant", "class_name": "Assistant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Assistant"] }],
  "vars": {
    // The One Brain folder memories and captured chats go to. Empty: memories stay private to the
    // person the key acts for, and chats go to your workspace's capture folder.
    "ONEBRAIN_FOLDER": ""
  },
  "observability": { "enabled": true }
}
