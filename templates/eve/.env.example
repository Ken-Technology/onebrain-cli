# Required: a One Brain workspace agent key (ob_...). It decides what the agent may read and write.
# A workspace admin makes one with the onebrain CLI:
#   onebrain admin agents create eve-agent --workspace-agent
#   onebrain admin keys create eve-agent
ONEBRAIN_API_KEY=

# Optional: the One Brain API. Unset, the agent uses https://api.useonebrain.com.
ONEBRAIN_URL=https://api.useonebrain.com

# Optional: the workspace slug. Unset, the agent uses the key's own workspace.
ONEBRAIN_WORKSPACE=
